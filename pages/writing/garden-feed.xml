---
permalink: /garden/feed.xml
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    {%- comment -%}
    Hand-rolled because jekyll-feed generates for posts only. The garden is
    deliberately NOT in the main feed (ADR-0001): posts_limit is 25, and one
    triage session would flush the essays out of it. Two publication rhythms,
    two feeds.

    Entries are ordered by `tended`, not `planted` — a garden note's news is
    that it changed, which is the whole difference between it and a post.
    {%- endcomment -%}
    <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
    <link href="{{ '/garden/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
    <link href="{{ '/garden/' | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ '/garden/feed.xml' | absolute_url }}</id>
    <title type="html">{{ site.title | smartify | xml_escape }} — the garden</title>
    <subtitle>Notes I am still growing: published early, revised in place, and separate from the posts.</subtitle>

    {%- assign notes = site.garden | sort: "tended" | reverse -%}
    {%- if notes.first -%}
        <updated>{{ notes.first.tended | default: notes.first.planted | date_to_xmlschema }}</updated>
    {%- endif -%}

    <author>
        <name>{{ site.author | xml_escape }}</name>
    </author>

    {%- for note in notes limit: 50 -%}
    <entry>
        <title type="html">{{ note.title | smartify | xml_escape }}</title>
        <link href="{{ note.url | absolute_url }}" rel="alternate" type="text/html" title="{{ note.title | xml_escape }}" />
        <published>{{ note.planted | date_to_xmlschema }}</published>
        <updated>{{ note.tended | default: note.planted | date_to_xmlschema }}</updated>
        <id>{{ note.url | absolute_url | xml_escape }}</id>
        <category term="{{ note.maturity }}" />
        {%- for tag in note.tags %}
        <category term="{{ tag | xml_escape }}" />
        {%- endfor %}
        <summary type="html">{{ note.description | default: '' | xml_escape }}</summary>
        <content type="html" xml:base="{{ note.url | absolute_url | xml_escape }}">
            {{- note.maturity | prepend: '&lt;p&gt;&lt;em&gt;Maturity: ' | append: '&lt;/em&gt;&lt;/p&gt;' -}}
            {{- note.content | strip | xml_escape -}}
        </content>
    </entry>
    {%- endfor %}
</feed>
